---
import "../styles/global.css";

const pageTitle =
  "Lucas Capriata - Full Stack Developer with Practical AI Experience";
const pageDescription =
  "Portfolio of Lucas Capriata, a full stack developer building AI-assisted products, automation workflows, and end-to-end web applications.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Lucas Capriata",
  jobTitle: "Full Stack Developer",
  description: pageDescription,
  knowsAbout: [
    "Full stack development",
    "Artificial intelligence",
    "Product engineering",
    "Automation",
    "VPS operations",
  ],
};

const projects = [
  {
    name: "Prode",
    status: "Private repository",
    publicUrl: "https://prode.caprilucas.dev/",
    summary:
      "A World Cup 2026 prediction assistant that combines match data, betting odds, probability normalization, and scoring rules to recommend better prode picks.",
    value:
      "Shows product thinking around uncertain data, domain logic, typed APIs, persistence, and recommendation flows.",
    technologies: [
      "TypeScript",
      "Next.js",
      "React",
      "Tailwind CSS",
      "PostgreSQL",
      "Drizzle ORM",
      "Odds API",
      "Docker",
      "pnpm",
    ],
  },
  {
    name: "AI Digest",
    status: "Private repository",
    publicUrl: "https://capri-noticias.vercel.app/",
    summary:
      "A configurable news digest system that fetches sources, deduplicates items, uses AI models to prioritize and summarize, and delivers personalized emails.",
    value:
      "Demonstrates practical AI orchestration, model adapters, scheduled automation, source ingestion, and email delivery.",
    technologies: [
      "TypeScript",
      "Node.js",
      "RSS",
      "Scraping",
      "OpenAI",
      "Anthropic",
      "DeepSeek",
      "Resend",
      "Supabase",
      "GitHub Actions",
    ],
  },
  {
    name: "Gerardo",
    status: "Private repository",
    publicUrl: "No public URL available",
    summary:
      "A personal finance automation platform with a DCA bot, web dashboard, broker integrations, reconciliation flows, alerts, and scheduled operational jobs.",
    value:
      "Highlights full stack ownership across product UI, domain modeling, background workflows, integrations, observability, and release operations.",
    technologies: [
      "TypeScript",
      "Node.js",
      "pnpm workspaces",
      "Turborepo",
      "Next.js",
      "Tailwind CSS",
      "shadcn/ui",
      "Supabase Postgres",
      "Drizzle ORM",
      "GitHub Actions",
      "Resend",
      "React Email",
      "Vercel",
      "IOL integration",
    ],
  },
];

const cvPath = "/cv/lucas-capriata-cv.pdf";
const hasPublicUrl = (url: string) => url.startsWith("https://") || url.startsWith("http://");
const contactEmail = "contact@caprilucas.dev";

const operations = [
  "VPS setup and maintenance",
  "Full stack development (Next.js, React, NestJS)",
  "Software engineering mindset",
  "Production-minded deployments",
  "PostgreSQL-backed services and migrations",
  "Scheduled jobs, GitHub Actions, and operational runbooks"
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="Lucas Capriata, full stack developer, AI developer, product engineer, automation, portfolio"
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.site ?? "https://lucascapriata.dev"} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <nav class="nav" aria-label="Primary navigation">
          <a class="brand" href="/" aria-label="Lucas Capriata portfolio home">
            <span class="brand-mark" aria-hidden="true">LC</span>
            <span>Lucas Capriata</span>
          </a>
          <div class="nav-links">
            <a href="#projects">Projects</a>
            <a href="#cv">CV</a>
            <a href="#operations">Operations</a>
            <a href="#contact">Contact</a>
          </div>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div>
            <p class="eyebrow">Full stack developer · AI product builder</p>
            <h1 id="hero-title">Lucas Capriata: practical end to end products.</h1>
            <p class="lead">
              I turn product ideas into working software: thoughtful interfaces,
              typed backends, automation workflows, AI integrations, data flows,
              deployment paths, and the operational details needed to keep them useful.
            </p>
            <div class="hero-actions" aria-label="Primary actions">
              <a class="button" href="#projects">View Projects</a>
              <a class="button secondary" href="#cv">View CV</a>
              <a class="button secondary" href="#contact">Contact Me</a>
            </div>
            <div class="proof-strip" aria-label="Professional focus areas">
              <div class="proof-item">
                <strong>AI in real workflows</strong>
                <span>Summaries, prioritization, recommendations, and automation where they improve the product.</span>
              </div>
              <div class="proof-item">
                <strong>Full stack ownership</strong>
                <span>Frontend, backend, data modeling, integrations, and release-ready product thinking.</span>
              </div>
              <div class="proof-item">
                <strong>Deployment mindset</strong>
                <span>From local prototypes to hosted services, cron jobs, VPS work, and production constraints.</span>
              </div>
            </div>
          </div>
          <div class="hero-visual" aria-label="Animated AI product system visual">
            <div class="ai-scene" aria-hidden="true">
              <div class="orbit orbit-one"></div>
              <div class="orbit orbit-two"></div>
              <div class="neural-core">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <div class="product-signal signal-prode">
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="product-signal signal-digest">
                <i></i>
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="product-signal signal-finance">
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="data-stream stream-one"></div>
              <div class="data-stream stream-two"></div>
              <div class="data-stream stream-three"></div>
            </div>
          </div>
        </section>

        <section class="section" id="projects" aria-labelledby="projects-title">
          <div class="section-header">
            <h2 id="projects-title">Selected projects</h2>
            <p>
              A focused set of projects that show how I approach product engineering,
              AI-assisted workflows, automation, and operational ownership.
            </p>
          </div>
          <div class="project-grid">
            {
              projects.map((project) => (
                <article class="project-card">
                  <div class="project-card-top">
                    <h3>{project.name}</h3>
                    <span>{project.status}</span>
                  </div>
                  <p class="project-summary">{project.summary}</p>
                  <p class="project-value">{project.value}</p>
                  <dl class="project-meta">
                    <div>
                      <dt>Public URL</dt>
                      <dd>
                        {
                          hasPublicUrl(project.publicUrl) ? (
                            <a class="project-url" href={project.publicUrl} target="_blank" rel="noreferrer">
                              {project.publicUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                            </a>
                          ) : (
                            project.publicUrl
                          )
                        }
                      </dd>
                    </div>
                    <div>
                      <dt>Repository</dt>
                      <dd>{project.status}</dd>
                    </div>
                  </dl>
                  <ul class="tech-list" aria-label={`${project.name} technologies`}>
                    {project.technologies.map((technology) => (
                      <li>{technology}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <section class="section" id="cv" aria-labelledby="cv-title">
          <div class="cv-panel">
            <div class="section-header">
              <h2 id="cv-title">CV</h2>
              <p>
                My professional background, skills, and experience in a shareable format
                for recruiting conversations and technical evaluation.
              </p>
            </div>
            <div class="cv-actions" aria-label="CV actions">
              <a class="button" href={cvPath} target="_blank" rel="noreferrer">View CV</a>
              <a class="button secondary" href={cvPath} download>Download CV</a>
            </div>
            <p class="cv-note">
              The CV opens as a PDF and can be shared directly. If it is temporarily unavailable,
              please use the contact section and I will send it over.
            </p>
          </div>
        </section>

        <section class="section" id="operations" aria-labelledby="operations-title">
          <div class="operations-layout">
            <div class="section-header">
              <h2 id="operations-title">Operational experience</h2>
              <p>
                I care about the path from code to a running product: deployments,
                configuration, scheduled jobs, data persistence, and maintenance.
                That includes hands-on work with VPS environments and the
                practical details around keeping services usable.
              </p>
            </div>
            <div class="ops-board" aria-label="Operational capabilities">
              {
                operations.map((item) => (
                  <div class="ops-item">
                    <span aria-hidden="true"></span>
                    <p>{item}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </section>

        <section class="section" id="contact" aria-labelledby="contact-title">
          <div class="contact-layout">
            <div class="section-header">
              <h2 id="contact-title">Contact</h2>
              <p>
                Open to full stack, AI product engineering, and automation-focused
                opportunities where practical product delivery matters.
              </p>
            </div>
            <div class="contact-panel">
              <p class="contact-label">Primary channel</p>
              <a
                class="contact-email"
                href={`mailto:${contactEmail}`}
              >
                {contactEmail}
              </a>
              <p class="contact-copy">
                Send a role description, project context, or a quick note about what
                you are building. I am especially interested in work that combines
                product engineering, AI workflows, and end-to-end ownership.
              </p>
              <div class="contact-actions">
                <a
                  class="button"
                  href={`mailto:${contactEmail}`}
                >
                  Email Me
                </a>
                <a
                  class="button secondary"
                  href="https://github.com/CapriLucas"
                  target="_blank"
                  rel="noreferrer"
                >
                  GitHub
                </a>
                <a
                  class="button secondary"
                  href="https://www.linkedin.com/in/lucas-capriata-1639b4183/"
                  target="_blank"
                  rel="noreferrer"
                >
                  LinkedIn
                </a>
              </div>
            </div>
          </div>
        </section>
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <span>© {new Date().getFullYear()} Lucas Capriata</span>
          <span>Full stack development · AI · product automation</span>
        </div>
      </footer>
    </div>
  </body>
</html>
